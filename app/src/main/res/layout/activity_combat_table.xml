<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_negro"
    android:padding="16dp">

    <!-- Título y subtítulo limpios de la sala -->
    <TextView
        android:id="@+id/tvNombreSalaMesa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/texto_blanco"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp"
        tools:text="Prueba sala" />

    <TextView
        android:id="@+id/tvEstadoYSala"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/texto_gris_claro"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreSalaMesa"
        app:layout_constraintWidth_max="480dp"
        tools:text="Código: ROLL67  •  ANTESALA" />

    <!-- Sección de Sonidos directos 2x2 sin borde (Solo visible para el Máster) -->
    <LinearLayout
        android:id="@+id/layoutSonidosMaster"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEstadoYSala"
        app:layout_constraintWidth_max="480dp"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Sonidos"
            android:textColor="@color/texto_blanco"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Fila 1 (2 botones) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSonidoEspadas"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Espadas"
                android:textColor="@color/texto_blanco"
                android:textSize="12sp"
                app:backgroundTint="@color/superficie_tarjeta"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSonidoHechizo"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Hechizo"
                android:textColor="@color/texto_blanco"
                android:textSize="12sp"
                app:backgroundTint="@color/superficie_tarjeta"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Fila 2 (2 botones) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSonidoRugido"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Rugido"
                android:textColor="@color/texto_blanco"
                android:textSize="12sp"
                app:backgroundTint="@color/superficie_tarjeta"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSonidoVictoria"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:elevation="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:stateListAnimator="@null"
                android:text="Victoria"
                android:textColor="@color/texto_blanco"
                android:textSize="12sp"
                app:backgroundTint="@color/superficie_tarjeta"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtítulo Registro de combate -->
    <TextView
        android:id="@+id/tvTituloLanzamiento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Registro de combate"
        android:textColor="@color/texto_blanco"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSonidosMaster"
        app:layout_constraintWidth_max="480dp" />

    <!-- Tarjeta de Log sin borde -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogCombate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/superficie_tarjeta"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloLanzamiento"
        app:layout_constraintWidth_max="480dp">

        <TextView
            android:id="@+id/tvUltimoLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/texto_blanco"
            android:textSize="14sp"
            tools:text="Guerrero SuperFuerte ataca a Goblin Explorador\nAtaque: 22 (D20: 18 + 4) vs CA 14 -> ¡Impacta!\nDaño: -7 PS (D8: 5 + 2)" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Título de la lista -->
    <TextView
        android:id="@+id/tvTituloListaCombatientes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Participantes en Sala"
        android:textColor="@color/texto_blanco"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardLogCombate"
        app:layout_constraintWidth_max="480dp" />

    <!-- Lista de combatientes en tiempo real -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCombatientes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutAccionesInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloListaCombatientes"
        app:layout_constraintWidth_max="480dp"
        tools:listitem="@layout/item_combatiente" />

    <!-- Contenedor inferior dinámico según fase y turno -->
    <LinearLayout
        android:id="@+id/layoutAccionesInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp">

        <!-- Botón del Máster en Antesala -->
        <Button
            android:id="@+id/btnSortearEIniciar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Sortear Turnos e Iniciar Combate"
            android:textColor="@color/texto_blanco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Mensaje de espera para jugadores en Antesala -->
        <TextView
            android:id="@+id/tvEsperandoMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="Esperando a que el Máster inicie el combate..."
            android:textColor="@color/texto_gris_claro"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Botón de acción cuando es TU turno en combate -->
        <Button
            android:id="@+id/btnTirarDadosTurno"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Tirar dado D20"
            android:textColor="@color/texto_blanco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Botón Salir -->
        <Button
            android:id="@+id/btnSalirMesa"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ABANDONAR SALA"
            android:textColor="@color/rojo_claro" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>