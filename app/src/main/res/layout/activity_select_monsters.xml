<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_negro"
    android:padding="16dp">

    <!-- Tarjeta destacada con el Nombre y Código de Sala (sin borde) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCodigoSala"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/superficie_tarjeta"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="480dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNombreSalaCabecera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/texto_blanco"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/chipCodigoSala"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Sala Mazmorra" />

            <TextView
                android:id="@+id/tvSubtituloCodigo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:text="Código para jugadores"
                android:textColor="@color/texto_gris_claro"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/chipCodigoSala"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNombreSalaCabecera" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCodigoSala"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textColor="@color/texto_blanco"
                android:textSize="20sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/rojo_principal"
                app:chipEndPadding="18dp"
                app:chipMinHeight="46dp"
                app:chipStartPadding="18dp"
                app:chipStrokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="ROLL67" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvTituloConfigurar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Configurar Encuentro"
        android:textColor="@color/texto_blanco"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardCodigoSala"
        app:layout_constraintWidth_max="480dp" />

    <TextView
        android:id="@+id/tvSubtituloConfigurar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Selecciona qué esbirros y jefe final atacarán a los jugadores:"
        android:textColor="@color/texto_gris_claro"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloConfigurar"
        app:layout_constraintWidth_max="480dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMonstruos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnIniciarCombate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtituloConfigurar"
        app:layout_constraintWidth_max="480dp"
        tools:listitem="@layout/item_monstruo_seleccion" />

    <Button
        android:id="@+id/btnIniciarCombate"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginBottom="4dp"
        android:text="Iniciar Combate con la Sala"
        android:textColor="@color/texto_blanco"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverSalas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp" />

    <Button
        android:id="@+id/btnVolverSalas"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="VOLVER A MIS SALAS"
        android:textColor="@color/rojo_claro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp" />

</androidx.constraintlayout.widget.ConstraintLayout>