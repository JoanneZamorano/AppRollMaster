<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#1A1625"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloTirada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🎲 Tirando D20..."
        android:textColor="#FFD54F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Contenedor del dado giratorio y el número centrado -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginVertical="16dp">

        <ImageView
            android:id="@+id/ivDadoD20"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Dado de 20 caras"
            android:src="@drawable/ic_dado_d20" />

        <TextView
            android:id="@+id/tvNumeroDado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="14dp"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="20"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDetalleResultadoDado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Calculando impacto..."
        android:textColor="#E0E0E0"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>