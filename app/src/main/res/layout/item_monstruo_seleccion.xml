<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/superficie_tarjeta"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Retrato vertical a la izquierda ocupando todo el alto de la tarjeta -->
        <ImageView
            android:id="@+id/ivAvatarMonstruo"
            android:layout_width="124dp"
            android:layout_height="0dp"
            android:contentDescription="Avatar del monstruo"
            android:scaleType="matrix"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Etiqueta Jefe Final arriba a la derecha del todo, sin fondo y en rojo -->
        <TextView
            android:id="@+id/chipJefe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:letterSpacing="0.08"
            android:text="JEFE FINAL"
            android:textColor="@color/rojo_claro"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- Nombre del monstruo -->
        <TextView
            android:id="@+id/tvNombreMonstruo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/texto_blanco"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_goneMarginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivAvatarMonstruo"
            app:layout_constraintTop_toBottomOf="@+id/chipJefe"
            tools:text="Liche Nigromante" />

        <!-- Estadísticas del monstruo -->
        <TextView
            android:id="@+id/tvStatsMonstruo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:textColor="@color/texto_gris_claro"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivAvatarMonstruo"
            app:layout_constraintTop_toBottomOf="@+id/tvNombreMonstruo"
            tools:text="PS: 60 | CA: 17 | Atq: +7" />

        <!-- Selector - 0 + alineado a la izquierda del bloque de texto -->
        <LinearLayout
            android:id="@+id/layoutContador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivAvatarMonstruo"
            app:layout_constraintTop_toBottomOf="@+id/tvStatsMonstruo"
            tools:ignore="TouchTargetSizeCheck">

            <Button
                android:id="@+id/btnMenos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="42dp"
                android:minHeight="42dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="@color/rojo_claro"
                android:textSize="18sp"
                android:textStyle="bold"
                app:strokeColor="@color/rojo_principal"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/texto_blanco"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="42dp"
                android:minHeight="42dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/rojo_claro"
                android:textSize="18sp"
                android:textStyle="bold"
                app:strokeColor="@color/rojo_principal"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>