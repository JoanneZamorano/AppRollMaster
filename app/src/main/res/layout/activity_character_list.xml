<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_negro"
    android:padding="16dp">

    <!-- Cabecera -->
    <TextView
        android:id="@+id/tvTituloLista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mis Personajes"
        android:textColor="@color/texto_blanco"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtituloLista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gestiona tus héroes o crea uno nuevo"
        android:textColor="@color/texto_gris_claro"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTituloLista" />

    <!-- Barra de carga mientras lee de Firestore -->
    <ProgressBar
        android:id="@+id/progressBarLista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/rojo_principal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnCrearPersonajeDesdeLista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtituloLista" />

    <!-- Texto si la lista está vacía -->
    <TextView
        android:id="@+id/tvSinPersonajes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aún no tienes ningún personaje creado."
        android:textColor="@color/texto_gris_claro"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/btnCrearPersonajeDesdeLista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtituloLista" />

    <!-- Listado con RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPersonajes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnCrearPersonajeDesdeLista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtituloLista"
        tools:listitem="@layout/item_personaje" />

    <!-- Botón Crear Nuevo Personaje -->
    <Button
        android:id="@+id/btnCrearPersonajeDesdeLista"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="Crear Nuevo Personaje"
        android:textColor="@color/texto_blanco"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp" />

    <!-- Botón Volver al Menú Principal -->
    <Button
        android:id="@+id/btnVolverMenu"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Volver al Menú Principal"
        android:textColor="@color/rojo_claro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="480dp" />

</androidx.constraintlayout.widget.ConstraintLayout>